# =============================================================================
# RetinaAI — .gitignore
# =============================================================================

# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest.ini

# ── Virtual environments ─────────────────────────────────────────────────────
retina_env/
test_venv/
wsl_env/
.venv/
venv/
env/

# ── Model checkpoints (too large for Git) ────────────────────────────────────
*.pth
*.pt
*.ckpt
*.h5

# ── PyInstaller build artifacts ──────────────────────────────────────────────
build/
dist/
*.spec
build_exe.py

# ── Local Experiments & Data Outputs ─────────────────────────────────────────
experiments/
outputs/
outputs/logs/
best pick/
scratch/
notebooks/
tests/
*.pdf
*.png
*.jpg
*.csv
*.json

# ── Secondary / Experimental Scripts (preserved locally) ────────────────────
/train_binary_lesion.py
/train_cascade.py
/train_ddr_attention_unet.py
/tune_all_postprocessing.py
/tune_binary_postprocessing.py
/tune_postprocessing.py
/make_matrix.py
/collect_best_picks.py
/patch_model.py
/wsl_requirements.txt
/wsl_setup.sh
/web_app.py
/train.py
/evaluate.py
/app.py
/generate_visualizations.py
/inference.py
/Dockerfile
/docker-compose.yml

# ── Secondary Configs (preserved locally) ────────────────────────────────────
configs/config_combined.yaml
configs/config_ddr.yaml
configs/config_ddr_attention_unet.yaml
configs/config_eophtha_combined.yaml
configs/config_focal.yaml
configs/config_multiclass_patch_hybrid.yaml
configs/binary_*.yaml

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.env

