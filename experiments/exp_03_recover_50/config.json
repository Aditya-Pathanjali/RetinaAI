{
    "dataset": {
        "root": "C:/Dissertation/Datasets/IDRiD/A. Segmentation/A. Segmentation",
        "train_images": "1. Original Images/a. Training Set",
        "test_images": "1. Original Images/b. Testing Set",
        "train_masks": "2. All Segmentation Groundtruths/a. Training Set",
        "test_masks": "2. All Segmentation Groundtruths/b. Testing Set",
        "lesion_classes": {
            "MA": "1. Microaneurysms",
            "HE": "2. Haemorrhages",
            "EX": "3. Hard Exudates",
            "SE": "4. Soft Exudates"
        },
        "class_names": [
            "MA",
            "HE",
            "EX",
            "SE"
        ],
        "mask_suffixes": {
            "MA": "_MA",
            "HE": "_HE",
            "EX": "_EX",
            "SE": "_SE"
        },
        "image_ext": ".jpg",
        "mask_ext": ".tif"
    },
    "split": {
        "train_ratio": 0.7,
        "val_ratio": 0.15,
        "test_ratio": 0.15,
        "random_seed": 42,
        "split_file": "outputs/split_metadata_exp03_recover_50.json"
    },
    "preprocessing": {
        "image_size": 512,
        "normalize_mean": [
            0.485,
            0.456,
            0.406
        ],
        "normalize_std": [
            0.229,
            0.224,
            0.225
        ],
        "apply_clahe": true,
        "clahe_clip_limit": 2.0,
        "clahe_tile_grid": [
            8,
            8
        ],
        "apply_bg_crop": true,
        "apply_green_enhance": true,
        "apply_illum_correct": true,
        "apply_denoise": false,
        "denoise_kernel": 3
    },
    "augmentation": {
        "enabled": true,
        "p_hflip": 0.5,
        "p_vflip": 0.0,
        "p_rotate": 0.5,
        "rotate_limit": 45,
        "p_brightness": 0.4,
        "brightness_limit": 0.2,
        "contrast_limit": 0.2,
        "p_elastic": 0.3,
        "elastic_alpha": 120,
        "elastic_sigma": 6,
        "p_grid": 0.3,
        "p_gamma": 0.4,
        "gamma_limit": [
            70,
            130
        ],
        "p_gauss_noise": 0.2,
        "p_sharpen": 0.3,
        "p_hue_sat": 0.2,
        "p_coarse_dropout": 0.0
    },
    "model": {
        "name": "AttentionUNet",
        "encoder_name": "resnet34",
        "encoder_weights": "imagenet",
        "in_channels": 3,
        "out_channels": 4,
        "base_features": 32,
        "encoder_depth": 4,
        "dropout_rate": 0.15,
        "use_attention": true,
        "bilinear": false
    },
    "loss": {
        "name": "dice_focal",
        "dice_weight": 0.6,
        "focal_weight": 0.4,
        "focal_alpha": 0.75,
        "focal_gamma": 2.0,
        "class_weights": [
            3.0,
            1.0,
            2.0,
            3.0
        ]
    },
    "training": {
        "epochs": 150,
        "batch_size": 4,
        "num_workers": 4,
        "pin_memory": true,
        "random_seed": 42,
        "optimizer": "adamw",
        "learning_rate": 0.0003,
        "weight_decay": 0.0001,
        "grad_clip": 1.0,
        "scheduler": "cosine_warm",
        "scheduler_T_0": 30,
        "scheduler_T_mult": 2,
        "min_lr": 1e-06,
        "warmup_epochs": 5,
        "early_stopping_patience": 30,
        "monitor_metric": "val_dice",
        "use_amp": true,
        "checkpoint_dir": "checkpoints",
        "save_best_only": false,
        "save_every_n": 25
    },
    "evaluation": {
        "threshold": {
            "MA": 0.15,
            "HE": 0.4,
            "EX": 0.25,
            "SE": 0.5
        },
        "threshold_search": {
            "MA": [
                0.1,
                0.35
            ],
            "HE": [
                0.25,
                0.55
            ],
            "EX": [
                0.2,
                0.4
            ],
            "SE": [
                0.35,
                0.6
            ]
        },
        "min_area": {
            "MA": 2,
            "HE": 10,
            "EX": 5,
            "SE": 20
        },
        "min_area_search": {
            "MA": [
                0,
                8
            ],
            "HE": [
                5,
                25
            ],
            "EX": [
                0,
                20
            ],
            "SE": [
                10,
                60
            ]
        },
        "use_tta": true
    },
    "experiment": {
        "name": "exp_03_recover_50",
        "output_root": "experiments",
        "log_dir": "outputs/logs"
    },
    "logging": {
        "level": "INFO",
        "save_to_file": true,
        "log_file": "outputs/logs/retinaai_exp03_recover_50.log"
    }
}