{
    "dataset": {
        "root": "C:/Dissertation/Datasets/IDRiD/A. Segmentation/A. Segmentation",
        "train_images": "1. Original Images/a. Training Set",
        "test_images": "1. Original Images/b. Testing Set",
        "train_masks": "2. All Segmentation Groundtruths/a. Training Set",
        "test_masks": "2. All Segmentation Groundtruths/b. Testing Set",
        "lesion_classes": {
            "MA": "1. Microaneurysms",
            "HE": "2. Haemorrhages",
            "EX": "3. Hard Exudates",
            "SE": "4. Soft Exudates"
        },
        "class_names": [
            "MA",
            "HE",
            "EX",
            "SE"
        ],
        "mask_suffixes": {
            "MA": "_MA",
            "HE": "_HE",
            "EX": "_EX",
            "SE": "_SE"
        },
        "image_ext": ".jpg",
        "mask_ext": ".tif"
    },
    "split": {
        "train_ratio": 0.7,
        "val_ratio": 0.15,
        "test_ratio": 0.15,
        "random_seed": 42,
        "split_file": "outputs/split_metadata.json"
    },
    "preprocessing": {
        "image_size": 512,
        "normalize_mean": [
            0.485,
            0.456,
            0.406
        ],
        "normalize_std": [
            0.229,
            0.224,
            0.225
        ],
        "apply_clahe": true,
        "clahe_clip_limit": 2.0,
        "clahe_tile_grid": [
            8,
            8
        ],
        "apply_bg_crop": true,
        "apply_green_enhance": true,
        "apply_illum_correct": true,
        "apply_denoise": false,
        "denoise_kernel": 3
    },
    "augmentation": {
        "enabled": true,
        "p_hflip": 0.5,
        "p_vflip": 0.0,
        "p_rotate": 0.5,
        "rotate_limit": 30,
        "p_brightness": 0.3,
        "brightness_limit": 0.15,
        "contrast_limit": 0.15,
        "p_elastic": 0.2,
        "elastic_alpha": 80,
        "elastic_sigma": 8,
        "p_grid": 0.2,
        "p_gamma": 0.3,
        "gamma_limit": [
            80,
            120
        ],
        "p_gauss_noise": 0.15
    },
    "model": {
        "name": "AttentionUNet",
        "encoder_name": "resnet34",
        "encoder_weights": "imagenet",
        "in_channels": 3,
        "out_channels": 4,
        "base_features": 32,
        "encoder_depth": 4,
        "dropout_rate": 0.15,
        "use_attention": true,
        "bilinear": false
    },
    "loss": {
        "name": "bce_dice",
        "bce_weight": 0.5,
        "dice_weight": 0.5,
        "tversky_alpha": 0.7,
        "tversky_beta": 0.3,
        "focal_gamma": 2.0,
        "focal_alpha": 0.25
    },
    "training": {
        "epochs": 100,
        "batch_size": 4,
        "num_workers": 4,
        "pin_memory": true,
        "random_seed": 42,
        "optimizer": "adamw",
        "learning_rate": 0.0001,
        "weight_decay": 0.0001,
        "grad_clip": 1.0,
        "scheduler": "cosine",
        "scheduler_patience": 15,
        "scheduler_factor": 0.5,
        "scheduler_T_max": 100,
        "min_lr": 1e-06,
        "early_stopping_patience": 20,
        "monitor_metric": "val_dice",
        "use_amp": true,
        "checkpoint_dir": "checkpoints",
        "save_best_only": false,
        "save_every_n": 10
    },
    "evaluation": {
        "threshold": 0.5
    },
    "experiment": {
        "name": "exp_02_fixed",
        "output_root": "experiments",
        "log_dir": "outputs/logs"
    },
    "logging": {
        "level": "INFO",
        "save_to_file": true,
        "log_file": "outputs/logs/retinaai.log"
    }
}